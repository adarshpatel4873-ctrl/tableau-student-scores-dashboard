      <column caption='Ethnic Group Clean' datatype='string' name='[Calculation_1298018563272704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([EthnicGroup],&quot;Not Specified&quot;)' />
      </column>
      <column caption='Test Prep Clean' datatype='string' name='[Calculation_1298018564202497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TestPrep]=&quot;completed&quot; then &quot;Test Prept Completed&quot;&#13;&#10;Else &quot;Test Prep Not Completed&quot;&#13;&#10;END' />
      </column>
      <column caption='Parent Marital Status Clean' datatype='string' name='[Calculation_1298018565636098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([ParentMaritalStatus],&quot;Not Specified&quot;)' />
      </column>
      <column caption='WKlY Study Hour clean' datatype='string' name='[Calculation_1298018566344707]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [WklyStudyHours]=&quot;&lt; 5&quot; THEN &quot;Less Than 5 hrs&quot;&#13;&#10;ELSEIF [WklyStudyHours]=&quot;&gt; 10&quot; THEN &quot;Greater Than 10 hrs&quot;&#13;&#10;ELSEIF [WklyStudyHours]=&quot;05-Oct&quot; THEN &quot;Between 5 to 10 hrs&quot;&#13;&#10;&#13;&#10;ELSE &quot;Not Specified&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Score' datatype='integer' name='[Calculation_1298018569183237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[WritingScore]+[ReadingScore]+[MathScore]' />
      </column>
      <column caption='AVG Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1298018569846790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1298018569183237]/3' />
      </column>
      <column caption='Overall Average Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1298018571808775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([Calculation_1298018569846790])}' />
      </column>
      <column caption='Delta' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1298018575413256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1298018569846790]-68.12' />
      </column>
      <column caption='Group Wise AVG' datatype='real' name='[Calculation_1298018577772553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED[Calculation_1298018563272704] : AVG([Calculation_1298018569846790]) }' />
      </column>
      <column caption='Letter Grade ' datatype='string' name='[Calculation_1298018583465995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1298018569846790]&gt;=90 then &quot;A (90-100)&quot;&#13;&#10;ELSEIF [Calculation_1298018569846790]&gt;=80 then &quot;B (80-89)&quot;&#13;&#10;ELSEIF [Calculation_1298018569846790]&gt;=70 then &quot;C (70-79)&quot;&#13;&#10;ELSEIF [Calculation_1298018569846790]&gt;=60 then &quot;D (60-69)&quot;&#13;&#10;ELSE &quot;F (&lt;60)&quot;&#13;&#10;END' />
      </column>
      <column caption='Is_Passing' datatype='string' name='[Calculation_1606431873986560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1298018571808775]&gt;=60 then &quot;Pass&quot;&#13;&#10;ELSE &quot;At Risk/ Fail&quot;&#13;&#10;END' />
      </column>
      <column caption='Parent Educ cleal' datatype='string' name='[Calculation_1606431886286849]' role='dimension' type='nominal'>
